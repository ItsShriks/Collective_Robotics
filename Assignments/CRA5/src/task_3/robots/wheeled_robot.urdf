<?xml version="1.0"?>
<robot name="wheeled_robot_with_gripper">

  <!-- Base -->
  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"/>
      <origin xyz="0 0 0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
  </link>

  <!-- LEFT WHEEL -->
  <link name="left_wheel">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
  </link>

  <!-- RIGHT WHEEL -->
  <link name="right_wheel">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
  </link>

  <!-- LEFT WHEEL JOINT -->
  <joint name="left_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.15 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="100" velocity="1000"/>
  </joint>

  <!-- RIGHT WHEEL JOINT -->
  <joint name="right_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.15 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="100" velocity="1000"/>
  </joint>

  <!-- Gripper Base (wrist) -->
  <link name="gripper_base">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.06 0.02"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.06 0.02"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
    </collision>
  </link>

  <!-- Gripper base fixed joint to robot base -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Left Finger -->
  <link name="left_finger">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.06 0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Right Finger -->
  <link name="right_finger">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.06 0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Left finger joint -->
  <joint name="left_finger_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0.05 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.04" effort="10" velocity="0.2"/>
  </joint>

  <!-- Right finger joint -->
  <joint name="right_finger_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="-0.05 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.04" effort="10" velocity="0.2"/>
  </joint>

</robot>
